{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5174/",
    "beforeBuildCommand": "npm run build:android",
    "frontendDist": "../dist-android"
  },
  "app": {
    "windows": [
      {
        "title": "PhotoMap",
        "width": 400,
        "height": 800,
        "minWidth": 0,
        "minHeight": 0,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "android": {
      "minSdkVersion": 24
    }
  }
}
