{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoMap",
  "version": "0.1.9",
  "identifier": "com.photomap.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PhotoMap",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Photography",
    "shortDescription": "Show geotagged photos on a map",
    "longDescription": "Lightweight desktop app that places photos on a map using GPS coordinates and shooting direction from EXIF metadata.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyQTIxRjlEMTBGMTRDMjYKUldRbVRQRVFuUitpZ3ZkRXplOGZsVFAwaU5wSEZvd0lQRExqazFMdjU2VTZGcWZxTHhORkY1aHEK",
      "endpoints": [
        "https://github.com/skibidius/PhotoMap/releases/latest/download/latest.json"
      ]
    }
  }
}
