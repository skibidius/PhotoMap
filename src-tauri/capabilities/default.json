{
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "core:default",
    "dialog:default",
    "updater:default",
    "process:default",
    "clipboard-manager:allow-write-image",
    "clipboard-manager:allow-write-text"
  ]
}
